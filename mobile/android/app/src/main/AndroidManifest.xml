<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- allowBackup="false" + fullBackupContent="false" + dataExtractionRules
         disable Android Auto Backup and Device-to-Device Transfer for this app
         (audit H4). Otherwise the WebView's localStorage and any Capacitor
         Preferences (which may include cached session-related data) would
         get backed up to Google Drive and restored on a new device, even
         after the user explicitly logged out. With these off, signing in
         on a new device is a fresh login. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links (2026-05-12). Tells Android that this app wants to
                 handle https://isverifiedby.me/* URLs. With autoVerify="true"
                 + matching /.well-known/assetlinks.json on the server,
                 Android will route the link DIRECTLY to this app without
                 showing an "Open with..." chooser. Without verification (or
                 if the SHA256 doesn't match), Android shows the chooser
                 dialog — user picks the app manually.

                 Note: Telegram's in-app browser intercepts links BEFORE
                 Android can route them. It opens in its WebView regardless.
                 User has to manually tap "open in external browser" from
                 Telegram's menu, then Android handles the route. Not a bug
                 we can fix from app side. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="isverifiedby.me" />
            </intent-filter>
            <!-- FA-011 fix 2026-05-15: removed http:// intent filters.
                 The site is HSTS-only (max-age=31536000), Cloudflare 301s
                 http→https before the request reaches origin, so the app
                 never sees a real http:// URL anyway. Keeping them broadens
                 the set of URLs the app claims and creates edge cases with
                 copied non-HTTPS links. -->
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- v0.1.3 (2026-05-28): FCM notification branding. Without these the
             system tray shows a generic placeholder (white square / launcher
             squish) on tap and a grey-tinted icon. With them, FCM picks up
             our brand silhouette and the accent orange tint. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_tappetite" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
